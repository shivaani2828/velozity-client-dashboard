generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { ADMIN PROJECT_MANAGER DEVELOPER }
enum TaskStatus { TODO IN_PROGRESS IN_REVIEW DONE }
enum Priority { LOW MEDIUM HIGH CRITICAL }
model User { id String @id @default(cuid()); email String @unique; name String; passwordHash String; role Role; projects Project[] @relation("ProjectOwner"); tasks Task[] @relation("AssignedDeveloper"); activities Activity[]; notifications Notification[]; refreshTokens RefreshToken[]; createdAt DateTime @default(now()) }
model Client { id String @id @default(cuid()); name String @unique; projects Project[]; createdAt DateTime @default(now()) }
model Project { id String @id @default(cuid()); name String; clientId String; ownerId String; client Client @relation(fields:[clientId], references:[id]); owner User @relation("ProjectOwner", fields:[ownerId], references:[id]); tasks Task[]; activities Activity[]; createdAt DateTime @default(now()); @@index([ownerId]); @@index([clientId]) }
model Task { id String @id @default(cuid()); title String; description String; projectId String; assigneeId String?; status TaskStatus @default(TODO); priority Priority @default(MEDIUM); dueDate DateTime; overdue Boolean @default(false); project Project @relation(fields:[projectId], references:[id], onDelete: Cascade); assignee User? @relation("AssignedDeveloper", fields:[assigneeId], references:[id]); activities Activity[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([projectId, status]); @@index([assigneeId, dueDate]); @@index([dueDate, overdue]) }
model Activity { id String @id @default(cuid()); taskId String; projectId String; actorId String; fromStatus TaskStatus?; toStatus TaskStatus?; message String; createdAt DateTime @default(now()); task Task @relation(fields:[taskId], references:[id], onDelete: Cascade); project Project @relation(fields:[projectId], references:[id], onDelete: Cascade); actor User @relation(fields:[actorId], references:[id]); @@index([projectId, createdAt]); @@index([taskId, createdAt]) }
model Notification { id String @id @default(cuid()); userId String; message String; read Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, read, createdAt]) }
model RefreshToken { id String @id @default(cuid()); tokenHash String @unique; userId String; expiresAt DateTime; user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId]) }
